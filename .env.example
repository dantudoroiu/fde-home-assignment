# live = call Claude; mock = deterministic fake responses (no API key needed)
LLM_MODE=mock
ANTHROPIC_API_KEY=

TRIAGE_MODEL=claude-haiku-4-5
DRAFT_MODEL=claude-sonnet-5-5
# full_context = whole KB in the cached draft prompt (small KBs); bm25 = keyword retrieval (large KBs)
GROUNDING=full_context
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_MAX_CONCURRENCY=4
# circuit breaker: open after N consecutive API failures, retry after the cooldown
LLM_BREAKER_FAILURE_THRESHOLD=5
LLM_BREAKER_COOLDOWN_SECONDS=60

DATABASE_PATH=triage.db
LOG_LEVEL=INFO
